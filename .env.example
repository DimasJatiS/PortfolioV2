# Copy to .env.local and fill in. Every value is optional in development:
# without Sanity credentials the site renders the bundled seed content.

# Public site origin (no trailing slash). Used for canonical URLs and hreflang.
NEXT_PUBLIC_SITE_URL=https://dimassj.vercel.app

# --- Sanity (https://www.sanity.io/manage) ---------------------------------
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret for the publish webhook -> /api/revalidate (server only).
SANITY_REVALIDATE_SECRET=
# Editor token, only needed for `pnpm seed` (server only, never expose).
SANITY_WRITE_TOKEN=
